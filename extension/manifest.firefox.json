{
  "manifest_version": 3,
  "name": "Flux Download Manager (Flux Browser Integration)",
  "version": "0.3.0",
  "description": "Automatic download capture and multi-layered video/stream detection (HLS/DASH/MP4/WebM) for Flux Download Manager.",
  "browser_specific_settings": {
    "gecko": {
      "id": "flux-extension@fluxdownloadmanager.org",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "downloads",
    "webRequest",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "scripts": ["js/background.js"]
  },
  "action": {
    "default_title": "Flux Media & Download Capture",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["js/content-script.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
