{
  "manifest_version": 3,
  "name": "OpenIDM Browser Integration (Cat Catch + Brisk Engine)",
  "version": "0.1.0",
  "description": "Automatic download capture and multi-layered video/stream detection (HLS/DASH/MP4/WebM) for OpenIDM.",
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@openidm.org",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "downloads",
    "webRequest",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "scripts": ["js/background.js"]
  },
  "action": {
    "default_title": "OpenIDM Media & Download Capture",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["js/content-script.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
