{
  "manifest_version": 3,
  "name": "Flux Download Manager",
  "version": "0.3.1",
  "description": "Automatic download capture and multi-layered video/stream detection (HLS/DASH/MP4/WebM/YouTube) for Flux Download Manager.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "downloads",
    "webRequest",
    "storage",
    "contextMenus",
    "scripting",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_title": "Flux Media & Download Capture",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "catch-script/catch.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "js/content-script.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "catch-script/catch.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
