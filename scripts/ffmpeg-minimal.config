# SPDX-License-Identifier: LGPL-2.1-or-later OR LGPL-3.0-or-later
# ==============================================================================
# Flux Download Manager — Minimal FFmpeg Configuration Specification
# Target: Windows x64 (x86_64-w64-mingw32 / UCRT)
# Pinned Source: FFmpeg 7.1 (Tag: n7.1, Commit: 04706f3, Tarball: ffmpeg-7.1.tar.xz)
# Pinned Toolchain: LLVM-MinGW 20240917 (Clang 19.1.0 / UCRT runtime)
# Pinned Source SHA-256: 40973d44970dbc83ef302b0609f2e74982be2d85916dd2ee7472d30678a7abe6
# License Profile: LGPL v2.1+ / LGPL v3.0 (No GPL-only codecs; clean commercial & open-source reuse)
# Expected Executable Footprint: ~12-16 MB (vs ~169 MB in general-purpose builds; ~91% reduction)
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Build System & Architecture Options
# ------------------------------------------------------------------------------
--arch=x86_64
--target-os=mingw32
--cross-prefix=x86_64-w64-mingw32-
--pkg-config=pkg-config
--pkg-config-flags="--static"
--enable-version3
--enable-small
--enable-lto
--enable-pic
--disable-shared
--enable-static
--disable-debug
--disable-doc
--disable-htmlpages
--disable-manpages
--disable-podpages
--disable-txtpages
--disable-autodetect
--extra-cflags="-Os -flto -DNDEBUG -DWIN32_LEAN_AND_MEAN"
--extra-ldflags="-Wl,--gc-sections -flto -static"

# ------------------------------------------------------------------------------
# Subsystem Isolation (Disable all unneeded libraries and network protocols)
# ------------------------------------------------------------------------------
--disable-all
--enable-ffmpeg
--enable-avcodec
--enable-avformat
--enable-avutil
--enable-swresample
--enable-avfilter
--disable-network
--disable-devices
--disable-indevs
--disable-outdevs
--disable-programs
--enable-ffmpeg

# ------------------------------------------------------------------------------
# Protocols (Local file and pipe I/O only; network handled in-process by Flux)
# ------------------------------------------------------------------------------
--enable-protocol=file
--enable-protocol=pipe
--enable-protocol=concat
--enable-protocol=subfile
--enable-protocol=cache

# ------------------------------------------------------------------------------
# Demuxers (Input formats presented by HLS/DASH/MSS segments and yt-dlp streams)
# ------------------------------------------------------------------------------
# MPEG-2 Transport Stream (HLS .ts segments)
--enable-demuxer=mpegts
# ISO Base Media File Format (CMAF, fMP4 .m4s segments, MP4, M4A, MOV)
--enable-demuxer=mov
# Matroska and WebM (DASH/YouTube VP9/AV1/Opus streams)
--enable-demuxer=matroska
# Audio elementary streams
--enable-demuxer=aac
--enable-demuxer=mp3
--enable-demuxer=flac
--enable-demuxer=ogg
--enable-demuxer=wav
# Subtitles
--enable-demuxer=webvtt
--enable-demuxer=srt
# Stream segment concatenation list
--enable-demuxer=concat
--enable-demuxer=rawvideo
# Synthetic test input
--enable-demuxer=lavfi

# ------------------------------------------------------------------------------
# Muxers (Container output formats supported by Flux Download Manager)
# ------------------------------------------------------------------------------
# Primary MP4 container for video + audio + subtitles
--enable-muxer=mp4
# Matroska container for full multi-track muxing
--enable-muxer=matroska
# WebM open web video container
--enable-muxer=webm
# Apple M4A audio container (ipod format tag in FFmpeg)
--enable-muxer=ipod
# MP3 audio container
--enable-muxer=mp3
# MPEG-2 TS container
--enable-muxer=mpegts
# Audio containers
--enable-muxer=ogg
--enable-muxer=opus
--enable-muxer=flac
--enable-muxer=wav
# Subtitle files
--enable-muxer=srt
--enable-muxer=webvtt
--enable-muxer=null

# ------------------------------------------------------------------------------
# Parsers (Required for header parsing, timestamps, and packet boundaries)
# ------------------------------------------------------------------------------
--enable-parser=h264
--enable-parser=hevc
--enable-parser=av1
--enable-parser=vp9
--enable-parser=vp8
--enable-parser=aac
--enable-parser=ac3
--enable-parser=mpegaudio
--enable-parser=opus
--enable-parser=vorbis
--enable-parser=flac

# ------------------------------------------------------------------------------
# Decoders (Stream inspection & header probing during stream-copy mapping)
# ------------------------------------------------------------------------------
--enable-decoder=h264
--enable-decoder=hevc
--enable-decoder=av1
--enable-decoder=vp9
--enable-decoder=vp8
--enable-decoder=aac
--enable-decoder=ac3
--enable-decoder=eac3
--enable-decoder=mp3
--enable-decoder=mp3float
--enable-decoder=opus
--enable-decoder=vorbis
--enable-decoder=flac
--enable-decoder=pcm_s16le
--enable-decoder=pcm_s24le
--enable-decoder=pcm_s32le
--enable-decoder=pcm_f32le
--enable-decoder=movtext
--enable-decoder=subrip
--enable-decoder=webvtt

# ------------------------------------------------------------------------------
# Encoders (Stream copy preferred; lightweight subtitle & audio encoders only)
# (NO heavy video encoders like libx264, libx265, libvpx, svtav1!)
# ------------------------------------------------------------------------------
# Converts WebVTT/SRT subtitles into MP4 mov_text subtitle tracks
--enable-encoder=movtext
# Converts WebVTT subtitles into MKV SubRip tracks
--enable-encoder=subrip
# WebVTT subtitle export
--enable-encoder=webvtt
# Native AAC audio encoder (LGPL, zero external dependencies)
--enable-encoder=aac
# Uncompressed PCM audio
--enable-encoder=pcm_s16le

# ------------------------------------------------------------------------------
# Bitstream Filters (CRITICAL for stream copying between containers)
# ------------------------------------------------------------------------------
# Converts HLS ADTS AAC audio into AudioSpecificConfig required by MP4
--enable-bsf=aac_adtstoasc
# Converts H.264 MP4 NAL units to Annex B start codes for TS
--enable-bsf=h264_mp4toannexb
# Converts HEVC MP4 NAL units to Annex B start codes
--enable-bsf=hevc_mp4toannexb
# Extracts SPS/PPS/VPS extradata headers
--enable-bsf=extract_extradata
# Merges VP9 invisible frames into superframe
--enable-bsf=vp9_superframe
# Merges AV1 temporal units
--enable-bsf=av1_frame_merge
--enable-bsf=null

# ------------------------------------------------------------------------------
# Audio Filters (Basic resync and format matching)
# ------------------------------------------------------------------------------
--enable-filter=aformat
--enable-filter=anull
--enable-filter=anullsrc
--enable-filter=null
--enable-filter=concat
--enable-filter=trim
--enable-filter=atrim
