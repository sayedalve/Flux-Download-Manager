// Flux Download Manager — Windows PE Version Resource & Application Metadata

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,3,0,0
PRODUCTVERSION  0,3,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Flux Open Source Team"
            VALUE "FileDescription",  "Flux Download Manager — Native Windows 11 Desktop Application"
            VALUE "FileVersion",      "0.3.0.0"
            VALUE "InternalName",     "flux.exe"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Flux Team. Licensed under GPL-3.0-or-later."
            VALUE "OriginalFilename", "flux.exe"
            VALUE "ProductName",      "Flux Download Manager"
            VALUE "ProductVersion",   "0.3.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
